if {[info exists ::env(ARIF_TEST_DEBUG)]} {
    exp_internal 1
}

proc arif_test_start {
    {page_size 5  }
    {buf_size  64 }
    {gen_all   yes}
} {
    global ARIF_TEST_BIN
    set run_cmd [list $ARIF_TEST_BIN -p $page_size -b $buf_size]
    if {$gen_all} {
        lappend $run_cmd -a
    }

    set stty_init {raw -echo}
    global spawn_id
    spawn {*}$run_cmd
}

proc arif_test_stop {} {
    global spawn_id
    send \x04
}

proc random_int {min max} {
    return [expr {int(rand() * ($max - $min + 1) + $min)}]
}

proc random_string {len} {
    set chars [split abcdefghijklmnopqrstuvwxyz ""]

    for {set i 0} {$i < $len} {incr i} {
        set offset [expr {int(rand() * 26)}]
        append str [lindex $chars $offset]
    }
    return $str
}

proc arif_fetch {} {
    global spawn_id
    send <\n
}

proc arif_query {text} {
    global spawn_id
    send >$text\n
}

proc arif_select_page {page} {
    global spawn_id
    send :$page\n
}
