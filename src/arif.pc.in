package=@PACKAGE@
version=@VERSION@

prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: ${package}
Description: Another Readline Input Framework
Version: ${version}
URL: https://www.nongnu.org/arif/
Libs: -L${libdir} -larif
Cflags: -I${includedir}
